{
  "expo": {
    "name": "Selah",
    "slug": "selah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2E4BE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.selah.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./assets/fonts/Lora_400Regular.ttf",
              "./assets/fonts/Lora_500Medium_Italic.ttf",
              "./assets/fonts/Lora_600SemiBold.ttf",
              "./assets/fonts/PlayfairDisplay_500Medium.ttf",
              "./assets/fonts/PlayfairDisplay_700Bold.ttf",
              "./assets/fonts/Nunito_400Regular.ttf",
              "./assets/fonts/Nunito_600SemiBold.ttf",
              "./assets/fonts/Nunito_700Bold.ttf",
              "./assets/fonts/Caveat_500Medium.ttf",
              "./assets/fonts/CormorantGaramond_600SemiBold_Italic.ttf"
            ]
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#9A6A3A",
          "defaultChannel": "daily-reminder"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "gifEnabled": false
          }
        }
      ]
    ],
    "scheme": "selah",
    "experiments": {
      "typedRoutes": true
    }
  }
}
