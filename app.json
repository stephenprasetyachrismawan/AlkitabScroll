{
  "expo": {
    "name": "Selah",
    "slug": "selah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selah.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2E4BE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.selah.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#9A6A3A",
          "defaultChannel": "daily-reminder"
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "VerseWidget",
              "displayName": "Ayat Hari Ini",
              "description": "Ayat hari ini dari Selah. Ketuk untuk ayat lain.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline",
                  "accessoryCircular"
                ],
                "initialLayout": "./src/widgets/VerseWidget.ios.tsx"
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/VerseWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "scheme": "selah",
    "experiments": {
      "typedRoutes": true
    }
  }
}
